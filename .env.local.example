# Copy to .env.local (gitignored) and fill in from the Firebase console:
#   Project settings -> General -> Your apps -> Web app -> SDK setup and configuration
# Keep real values OUT of this file — it is committed, and it is the template for standing the
# app up on a different Firebase project (the university's account, or next year's event).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<project-id>
VITE_FIREBASE_STORAGE_BUCKET=<project-id>.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Where the app is served. Booth QR payloads embed this, so it must match Hosting exactly.
VITE_APP_ORIGIN=https://<project-id>.web.app

# Force the local emulators even when a real config is present (see SETUP.md 7).
# VITE_USE_EMULATOR=true
