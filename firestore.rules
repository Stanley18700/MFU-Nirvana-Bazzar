rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function role() { return request.auth.token.get('role', ''); }
    function isAdmin() { return signedIn() && role() == 'admin'; }
    function isOrganizer() { return signedIn() && role() == 'organizer'; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Spec §7.4 — every consequential write goes through Cloud Functions.

    // Public: the landing page reads the live event's name and dates before anonymous
    // sign-in has resolved. Holds nothing sensitive — name, dates, days, QR period, prefix.
    match /events/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // §10 — self-service erasure requests, written only by the requestErasure callable. The
    // visitor reads their own to see it was filed; admins read them all for the inbox.
    match /erasureRequests/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    match /booths/{boothId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /boothSecrets/{boothId} {
      allow read, write: if false;
    }

    match /invites/{inviteId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // A booth's survey. Any signed-in visitor may read it — they need the questions to answer
    // them — and only saveSurvey writes.
    match /surveys/{boothId} {
      allow read: if signedIn();
      allow write: if false;
    }

    /**
     * Answers. Readable by an admin and by the organizer of that booth, which is exactly why no
     * document here carries a visitor id (§10 — sensitive answers are never shown per person).
     * A list query must filter on boothId, or the rule cannot prove the caller owns the rows.
     */
    match /surveyResponses/{id} {
      allow read: if isAdmin()
                  || (isOrganizer() && resource.data.boothId == request.auth.token.get('boothId', ''));
      allow write: if false;
    }

    // The "already answered" marker, kept apart from the answers so that reading one tells you
    // nothing about the other. Only the visitor it belongs to, and admins.
    match /surveyTaken/{id} {
      allow read: if isAdmin() || (signedIn() && id.split('_')[0] == request.auth.uid);
      allow write: if false;
    }

    match /refData/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /scans/{scanId} {
      allow read: if isAdmin() || (signedIn() && resource.data.visitorId == request.auth.uid);
      allow write: if false;
    }

    match /prizeTiers/{tierId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /stockAdjustments/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    /*
     * A visitor's own unlock rows, and the admin's. `isOrganizer()` used to be here too, which
     * let any booth organizer list every visitor's unlocks — visitor id included — when nothing
     * in the app asks them to: the prize desk reads what it needs through the
     * `lookupRedemption` callable, which runs as the server and never consults these rules.
     */
    match /tierUnlocks/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.visitorId == request.auth.uid);
      allow write: if false;
    }

    match /auditLog/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Stage draw results (§6.7) and the frozen summary written before an event is purged.
    match /draws/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /archives/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /rateLimits/{id} {
      allow read, write: if false;
    }

    // Live counters. Organizers may read booth counters and the event shards
    // (booth screen shows own count + event total); admins read everything.
    match /stats/event {
      allow read: if isAdmin() || isOrganizer();
      allow write: if false;
      match /shards/{shard} {
        allow read: if isAdmin() || isOrganizer();
        allow write: if false;
      }
    }
    match /stats/booths/items/{boothId} {
      allow read: if isAdmin() || isOrganizer();
      allow write: if false;
    }
    match /stats/buckets/items/{bucketId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    /*
     * §4.1/§10 — who the visitors are: country, institution, school, ethnic group, and the
     * cross-school matrix. Admin only, and kept out of the event shards above for that
     * reason: an organizer's booth screen subscribes to those shards for the event total, so
     * anything living there is on every organizer's device whether their screen draws it or
     * not. The dashboard's under-5 suppression is a render filter, not access control.
     */
    match /stats/demographics {
      allow read: if isAdmin();
      allow write: if false;
      match /shards/{shard} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
