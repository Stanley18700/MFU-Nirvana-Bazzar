# Cloud Functions configuration.
#
# Copy to functions/.env, which is gitignored. Keep real values OUT of this file — it IS
# committed, and it is the template for standing the app up on another Firebase project (the
# university's account, or next year's event).
#
# Everything here is a plain deploy-time parameter. The one real secret, EMAILJS_PRIVATE_KEY,
# is never written to a file — see the bottom of this file.

# Where the app is served. Booth QR payloads and invitation links embed this, so it must match
# Firebase Hosting exactly and match VITE_APP_ORIGIN in .env.local.
APP_ORIGIN=https://<project-id>.web.app

# ---------------------------------------------------------------------------------------
# EmailJS — the booth organizer and admin invitations, and nothing else.
#
# The three account mails a visitor sees (address verification, password reset, address
# change) come from Firebase Auth's own templates instead, so nothing here affects them.
# See SETUP.md §2a.
#
# All of this is OPTIONAL. Leave it blank and invitations are not emailed: the admin gets a
# copyable single-use link per organizer instead, which is a perfectly good way to invite a
# dozen people. Nothing else in the app is affected.
#
# The wording and layout of the invitation live in the EmailJS dashboard, not in this repo.
# What the code controls is the set of variables a template may interpolate — see
# templateParams() in functions/src/mailer.ts. A {{placeholder}} with no matching key renders
# as empty text rather than failing, so keep the two in step.
# ---------------------------------------------------------------------------------------

# EmailJS → Email Services. The connected mail service that actually delivers.
#   EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_SERVICE_ID=

# EmailJS → Account → General → Public Key. Not a secret; it identifies the account.
EMAILJS_PUBLIC_KEY=

# Booth organizer invitation. Uses every variable: to_email, to_name, booth_name, event_name,
# event_dates, expires, invite_link.
EMAILJS_TEMPLATE_INVITE=

# Administrator invitation — same design, wording without a booth (admins have no boothId).
# Optional, and separate on purpose: sending an admin the organizer template greets them with
# "run the booth screen for" and a gap where the booth name should be. Left blank, an admin
# invitation falls back to the copyable link.
#
# NOTE: EmailJS's free plan allows only TWO templates per account, so a second one may mean
# deleting an unused template or upgrading.
EMAILJS_TEMPLATE_INVITE_ADMIN=

# The private key is NOT kept here. It goes to Secret Manager, which is what `defineSecret` in
# functions/src/mailer.ts reads:
#
#   firebase functions:secrets:set EMAILJS_PRIVATE_KEY
#
# Copy it from EmailJS → Account → General → Private Key, using the dashboard's copy button.
# It is what allows a *server* — as opposed to a browser — to call the API at all, so
# Account → Security must also have "Allow EmailJS API for non-browser applications" ON;
# with it off every send comes back 403.
#
# Until the private key, the service id, the public key and EMAILJS_TEMPLATE_INVITE are all
# set, mailConfigured() is false and invitations fall back to copyable links.
