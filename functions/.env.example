# Cloud Functions configuration.
#
# Copy to functions/.env, which is gitignored. Keep real values OUT of this file — it IS
# committed, and it is the template for standing the app up on another Firebase project (the
# university's account, or next year's event).
#
# Everything here is a plain deploy-time parameter. The one real secret, RESEND_API_KEY, is
# never written to a file — see the bottom of this file.

# Where the app is served. Booth QR payloads and invitation links embed this, so it must match
# Firebase Hosting exactly and match VITE_APP_ORIGIN in .env.local.
APP_ORIGIN=https://<project-id>.web.app

# ---------------------------------------------------------------------------------------
# Resend — the booth organizer invitation, and nothing else.
#
# The three account mails a visitor sees (address verification, password reset, address
# change) come from Firebase Auth's own templates instead, so nothing here affects them.
# See SETUP.md §2a.
#
# All of this is OPTIONAL. Leave it blank and invitations are not emailed: the admin gets a
# copyable single-use link per organizer instead, which is a perfectly good way to invite a
# dozen people. Nothing else in the app is affected.
# ---------------------------------------------------------------------------------------

# The sender, as `Name <address@domain>`. The domain must be verified in the Resend dashboard
# (Domains → Add). Mail from an unverified domain is refused outright, and that is the usual
# reason a first send fails.
#   RESEND_FROM=MFU InterFest <invites@mfu.ac.th>
RESEND_FROM=

# Optional. Where a reply from a confused organizer should land — a real inbox somebody reads,
# rather than the no-reply sender. Left blank, replies go to RESEND_FROM.
#   RESEND_REPLY_TO=oia@mfu.ac.th
RESEND_REPLY_TO=

# The API key is NOT kept here. It goes to Secret Manager, which is what `defineSecret` in
# functions/src/mailer.ts reads:
#
#   firebase functions:secrets:set RESEND_API_KEY
#
# Paste the key from the Resend dashboard (API Keys → Create, "Sending access" is enough).
# Until it is set, mailConfigured() is false and invitations fall back to copyable links.
