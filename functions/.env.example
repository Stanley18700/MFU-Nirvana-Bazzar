# Copy to functions/.env (gitignored). Keep real values OUT of this file — it is committed.
# Must match VITE_APP_ORIGIN in .env.local and the Hosting domain.
APP_ORIGIN=https://<project-id>.web.app

# EmailJS, server-side (spec 6.4). It sends ONE message: the organizer invitation. The three
# account mails a visitor sees — address verification, password reset, address change — come
# from Firebase Auth's own templates instead (SETUP.md 1a), so nothing here affects them.
# Optional: leave blank and organizer invites fall back to a copyable link instead of sending
# mail. Get these from the EmailJS dashboard.
# The PRIVATE key is never stored here — it lives in Secret Manager:
#   firebase functions:secrets:set EMAILJS_PRIVATE_KEY
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_INVITE=
EMAILJS_PUBLIC_KEY=

# Festival feedback: the Google Form whose responses the admin dashboard pulls in (SETUP.md 4a).
# The id is the long token in the form's edit URL. Leave blank to turn the feature off.
FEEDBACK_FORM_ID=
