{
  "name": "mfu-passport-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": { "node": "20" },
  "scripts": {
    "prebuild": "node ../scripts/copy-shared.mjs",
    "build": "tsc",
    "watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "seed": "npm run build && node lib/seed.js",
    "seed:emulator": "npm run build && node lib/seed.js --emulator",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.8.0"
  }
}
