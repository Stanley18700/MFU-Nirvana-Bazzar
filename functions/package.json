{
  "name": "mfu-passport-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "prebuild": "node ../scripts/copy-shared.mjs",
    "build": "tsc",
    "watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "seed": "npm run build && node lib/seed.js",
    "seed:emulator": "npm run build && node lib/seed.js --emulator",
    "rescue:admin": "npm run build && node lib/rescueAdmin.js",
    "logs": "firebase functions:log",
    "feedback:pull": "npm run build && node -e \"require('./lib/feedback').pullFeedback().then((r) => console.log(r))\""
  },
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.3.0",
    "google-auth-library": "^10.9.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.8.0"
  }
}
