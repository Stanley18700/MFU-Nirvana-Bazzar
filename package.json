{
  "name": "mfu-go-global-passport",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "emulators": "firebase emulators:start --export-on-exit=.emulator-data --import=.emulator-data || firebase emulators:start --export-on-exit=.emulator-data",
    "deploy": "npm run build && npm --prefix functions run build && firebase deploy",
    "seed": "npm --prefix functions run seed",
    "seed:emulator": "npm --prefix functions run seed:emulator",
    "reset:emulator": "node scripts/reset-emulator.mjs",
    "e2e": "npm run reset:emulator && npm run seed:emulator && node scripts/e2e.mjs",
    "e2e:restore": "npm run reset:emulator && npm run seed:emulator && node scripts/e2e-restore.mjs"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "recharts": "^3.10.1",
    "zxing-wasm": "^2.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
